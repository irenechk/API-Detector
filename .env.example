# ─────────────────────────────────────────────
# ZADDP - Environment Variables (Production)
# ─────────────────────────────────────────────
# Copy this file and rename to .env, or set these
# variables in your hosting dashboard.
#
# For Vercel: Set under Project Settings → Environment Variables
# For Railway: Set under Variables tab

# ── Backend (FastAPI) ──

# PostgreSQL connection string (use asyncpg driver)
# Neon example: postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb
POSTGRES_PASSWORD=zaddp_secret_2024
DATABASE_URL=postgresql+asyncpg://zaddp:zaddp_secret_2024@localhost:5432/zaddp

SECRET_KEY=change-me-to-a-random-value

# Comma-separated emails allowed to call ML governance write endpoints.
# Azure AD tokens carry no role claim, so list the admins explicitly.
ML_ADMIN_EMAILS=admin@zaddp.io

# Optional bearer token required by POST /api/v1/scanner/analyze (used by the CLI).
# Leave empty to allow unauthenticated access, matching the existing scanner API.
SCANNER_API_TOKEN=

# Allowed CORS origins — JSON array of frontend URLs
# Vercel example: ["https://zaddp.vercel.app","https://zaddp-git-main.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost","http://localhost:80"]

# ── Frontend (Next.js) ──

# Backend API base URL (without trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth.js — required for authentication. Must be identical for the
# frontend and backend so FastAPI can decrypt the session JWE.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here

# Azure AD (Microsoft Entra ID) — OAuth credentials.
# Rotate the previously committed client secret if this repository is public.
AZURE_AD_CLIENT_ID=fbeb816b-492d-4b28-b478-316ed613555c
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_TENANT_ID=bf46a35a-9b7c-4f28-9849-e03166140273
